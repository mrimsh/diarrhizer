# Example environment variables for Diarrhizer
# Copy to `.env` (do NOT commit `.env`).

# Hugging Face token (required for diarization / gated models)
HF_TOKEN=hf_your_token_here

# Optional: default device ("cpu" or "cuda")
DIARRHIZER_DEVICE=cuda

# Optional: default output directory
DIARRHIZER_OUT=./out

# Optional: explicit path to ffmpeg.exe, used instead of searching PATH
# (checked by FFmpegAdapter and `python -m diarrhizer doctor`)
DIARRHIZER_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: API keys of summary providers (the GUI's "Саммаризация" screen writes them here).
# summary_providers.json only names the variable (api_key_env); it never holds the key.
# ChatGPT / Claude subscription providers need no key: they use the sign-in of `codex login` / `claude auth login`.
DIARRHIZER_LLM_KEY_OPENROUTER=sk-or-your-key-here
