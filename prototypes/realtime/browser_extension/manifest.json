{
  "manifest_version": 3,
  "name": "Diarrhizer capture (research prototype)",
  "version": "0.0.1",
  "description": "Research prototype: sends the audio of the current tab and/or the microphone to a receiver on 127.0.0.1. Not for publication.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://discord.com/*",
    "https://telemost.yandex.ru/*",
    "https://telemost.360.yandex.ru/*"
  ],
  "action": {
    "default_title": "Diarrhizer capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "capture-tab-and-mic": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Start capturing this tab's audio and the microphone"
    },
    "stop-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop capturing"
    }
  }
}
