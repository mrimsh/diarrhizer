{
  "default": "ChatGPT",
  "providers": {
    "ChatGPT": {
      "kind": "codex-cli",
      "timeout_seconds": 600
    },
    "Claude": {
      "kind": "claude-cli",
      "model": "sonnet",
      "timeout_seconds": 600
    },
    "OpenRouter": {
      "kind": "openai-api",
      "endpoint": "https://openrouter.ai/api/v1",
      "model": "openai/gpt-4o-mini",
      "api_key_env": "DIARRHIZER_LLM_KEY_OPENROUTER",
      "temperature": 0.3,
      "max_tokens": 4000,
      "price_input": 0.15,
      "price_output": 0.6,
      "timeout_seconds": 600
    },
    "Ollama (local)": {
      "kind": "openai-api",
      "endpoint": "http://localhost:11434/v1",
      "model": "llama3.1",
      "timeout_seconds": 1800
    },
    "Anthropic API": {
      "kind": "anthropic-api",
      "endpoint": "https://api.anthropic.com",
      "model": "claude-sonnet-5-5",
      "api_key_env": "DIARRHIZER_LLM_KEY_ANTHROPIC_API",
      "timeout_seconds": 600
    }
  }
}
